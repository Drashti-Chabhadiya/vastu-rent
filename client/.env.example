# ─── Better Auth ─────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET and BETTER_AUTH_URL belong ONLY in the server .env

# ─── API ─────────────────────────────────────────────────────────────────────
# Vite only exposes VITE_-prefixed variables to client-side code


VITE_API_BASE_URL=http://localhost:4000/api
VITE_AUTH_URL=http://localhost:4000/api/auth


# ─── APK Download ─────────────────────────────────────────────────────────────
VITE_APK_PATH=/vastu-rent.apk