#!/usr/bin/env sh

# Check if any files in the client directory are staged for commit
if ! git diff --cached --name-only | grep -q "^client/"; then
  echo "⏭️ No client files changed, skipping Client (Frontend) pre-commit checks..."
  exit 0
fi

echo "🔍 Running Client (Frontend) pre-commit checks..."

CD_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$CD_DIR" || exit 1

echo "▶ Step 1: Client ESLint..."
pnpm run lint || { echo "❌ Client ESLint failed!"; exit 1; }

echo "▶ Step 2: Client Prettier Check..."
pnpm run format:check || { echo "❌ Client Prettier check failed!"; exit 1; }

echo "▶ Step 3: Client TypeScript Type Checking..."
pnpm run typecheck || { echo "❌ Client TypeScript typecheck failed!"; exit 1; }

echo "✅ Client pre-commit checks passed!"
