{
  "name": "test-vite",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && rm -f dist/vastu-rent.apk dist/**/*.apk 2>/dev/null || true",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix",
    "format:check": "prettier --check .",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && husky client/.husky",
    "mobile:sync": "npm run build && npx cap sync",
    "mobile:open:android": "npx cap open android",
    "mobile:run:android": "npx cap run android",
    "mobile:run:android:live": "npx cap run android --live-reload",
    "mobile:run:ios:live": "npx cap run ios --live-reload",
    "mobile:dev": "vite dev --port 3000 --host",
    "apk:update": "./update-apk.sh",
    "apk:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug && cd .. && ./update-apk.sh"
  },
  "dependencies": {
