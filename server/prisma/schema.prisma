// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



enum Role {
  user
  owner
  admin
  superAdmin
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(user)
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Bank & UPI Settlement details
  upiId          String?
  bankName       String?
  accountNumber  String?
  ifscCode       String?
  accountHolder  String?

  // Alert preferences
  bookingAlerts    Boolean @default(true)
  settlementAlerts Boolean @default(true)
  marketingAlerts  Boolean @default(false)
  
  // Relations
  sessions      Session[]
  accounts      Account[]
  products      Product[] // User એ લિસ્ટ કરેલી વસ્તુઓ (Owner)
  rentals       Rental[]  // User એ ભાડે લીધેલી વસ્તુઓ (Renter)
  reviews       Review[]  // User એ આપેલા Reviews
  likes         Like[]    // User એ લાઈક કરેલી વસ્તુઓ
  deleteRequests DeleteProductRequest[] @relation("AdminRequests")
  categoryRequests CategoryRequest[]
  disputes         Dispute[]         @relation("ReportedDisputes")
  notifications    Notification[]
  payouts          Payout[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  
  ipAddress String?
  userAgent String?
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

// --- Marketplace Specific Tables ---

model Category {
  id       String    @id @default(cuid())
  name     String    @unique // e.g., "Electronics", "Clothing", "Tools"
  icon     String?   // Lucide icon name
  color    String?   // Hex color for the icon/category
  image    String?   // Uploaded image URL
  products Product[]
}

model Product {
  id              String   @id @default(cuid())
  title           String   // e.g., "Canon EOS R5" or "Designer Wedding Dress"
  description     String
  price           Float    // Rent per day/hour
  securityDeposit Float    @default(0) // Refundable deposit
  location        String   // કઈ જગ્યાએ વસ્તુ ઉપલબ્ધ છે
  images          String[] // Image URLs
  isAvailable     Boolean  @default(true)
  
  // New Enhanced Fields
  condition       String?  // e.g., "Like New", "Good", "Fair"
  features        String[] // ["WiFi", "4K Video", "Touchscreen"]
  deliveryOptions String[] // ["Pickup", "Delivery", "Self-Pickup"]
  pickupReturnDetails String?
  tags            String[] // ["Photography", "Camera", "Canon"]
  minDuration     Int      @default(1) // Minimum rental days
  maxDuration     Int?     // Maximum rental days (null for unlimited)
  
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  
  rentals     Rental[]
  reviews     Review[]
  likes       Like[]
  deleteRequests DeleteProductRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Rental {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  
  renterId   String
  renter     User     @relation(fields: [renterId], references: [id])
  
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  rentalFee  Float    // Actual rental cost (price * duration)
  depositAmount Float @default(0) // Security deposit paid
  
  status     String   @default("pending") // "pending", "confirmed", "picked_up", "in_use", "returned", "completed", "cancelled"
  paymentStatus String @default("pending") // "pending", "partial", "paid", "refunded"
  paymentMethod String @default("online")  // "online", "cash"
  
  pickupOTP  String?
  returnOTP  String?
  
  transactionId String? // Razorpay transaction ID
  
  dispute    Dispute?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String?
  
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("review")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("like")
}

model DeleteProductRequest {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  adminId     String
  admin       User     @relation("AdminRequests", fields: [adminId], references: [id])
  status      String   @default("pending") // "pending", "approved", "rejected"
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("delete_product_request")
}

model CategoryRequest {
  id          String   @id @default(cuid())
  name        String
  icon        String?
  color       String?
  image       String?
  status      String   @default("pending") // "pending", "approved", "rejected"
  reason      String?  // reason for rejection
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("category_request")
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  discount    Float     // Percentage discount or fixed value
  type        String    @default("percentage") // "percentage" or "fixed"
  maxDiscount Float?    // Maximum discount amount for percentage type
  minBooking  Float?    // Minimum booking price to apply coupon
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  usageLimit  Int?      // Max times coupon can be used
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("coupon")
}

model Dispute {
  id          String   @id @default(cuid())
  rentalId    String   @unique
  rental      Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  reportedById String
  reportedBy  User     @relation("ReportedDisputes", fields: [reportedById], references: [id])
  reason      String
  description String
  status      String   @default("open") // "open", "resolved", "dismissed"
  resolution  String?  // resolution description
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("dispute")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // "info", "booking", "payment", "alert"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notification")
}

model Payout {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  amount        Float
  status        String   @default("pending") // pending, approved, rejected, paid
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payout")
}

